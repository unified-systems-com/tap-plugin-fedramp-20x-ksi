        {
          "entity": {
            "entity_id": "0197fed0-0000-7000-8000-000c00000002",
            "entity_type": "search",
            "name": "Open Findings Detail Per Entity (Not Covered By Active Exception)",
            "dimensions": {"compliance": "fedramp-20x"}
          },
          "node": {
            "name": "Open Findings Detail Per Entity (Not Covered By Active Exception)",
            "description": "Per-entity list of open findings that are not covered by any active exception. Returns one row per finding with entity_id (the host) and name (the finding title). Consumed by the status-badge info window.",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (e)-[:HAS_FINDING]->(f:finding)",
                "WHERE f.status = \"open\"",
                "NOT EXISTS {",
                "  MATCH (x:exception)-[:COVERS_FINDING]->(f)",
                "  WHERE x.status = \"active\"",
                "}",
                "RETURN e.entity_id AS entity_id, f.name AS name"
              ]
            }
          }
        }
      ],
